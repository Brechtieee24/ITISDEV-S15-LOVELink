<!-- residency-logged-in.hbs -->
<div class="residency-page">
  {{> navbar activePage="residency" }}

  <div class="main-content-wrapper">
    <!-- Left Column (Avatar, Button, QR) -->
    <div class="left-column">
      <div class="user-avatar-wrapper">
        <img class="user-avatar" src="{{photo}}" alt="User" />
      </div>

      <!-- Time Out Button -->
      <a href="/residency-logged-out" class="update-btn-wrapper time-out-btn">
        <div class="update-btn-text">Time Out</div>
      </a>

      <!-- QR Code -->
      <div class="qr-code-wrapper">
        <img class="qr-img" src="{{qrCode}}" alt="QR Code" />
      </div>
    </div>

    <!-- Right Column (Name, Date, Table, Buttons) -->
    <div class="right-column">
      <!-- Name -->
      <div class="profile-name">
        {{firstName}} {{lastName}} <span class="italic">({{committee}})</span>
      </div>

      <!-- Timestamp -->
      <div class="current-timestamp" id="timestamp">
        Today is ...
      </div>

      <!-- Residency Table (You are logged in, and Time-In) -->
      <div class="residency-table-wrapper">
        <div class="table-header">You are currently logged in!</div>
        <div class="table-content">
          <div class="table-row">
            <strong>Time in:</strong> {{timeIn}}
          </div>
        </div>
      </div>

      <!-- History Buttons -->
      <div class="history-buttons center-buttons">
        <div id="residency-history-btn" class="secondary-btn">Residency History</div>
        <div id="activity-history-btn" class="secondary-btn">Activity History</div>
      </div>

    </div>
  </div>
</div>

<!-- Modal Structure (hidden initially) -->
<div id="residency-history-modal" class="modal hidden">
  <div class="modal-content">
    <span class="close-modal-btn">&times;</span>
    <h2>Residency History</h2>
    <table class="modal-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Time In</th>
          <th>Time Out</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody id="modal-table-body">
        <!-- Filled by JS -->
      </tbody>
    </table>
  </div>
</div>

<!-- Activity History Modal -->
<div id="activity-history-modal" class="modal hidden">
  <div class="modal-content">
    <span class="close-modal-btn activity-close-btn">&times;</span>
    <h2>Activity History</h2>
    <table class="modal-table">
      <thead>
        <tr>
          <th>Activity</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody id="activity-modal-table-body">
        <!-- Filled by JS -->
      </tbody>
    </table>
  </div>
</div>

<!-- Modal overlay -->
<div id="modal-overlay" class="modal-overlay hidden"></div>

<!-- Include the JavaScript at the end -->
<script src="/js/residency.js"></script>

 <script>
  function updateTimestamp() {
    // Create a new Date and convert to UTC+8 (Philippine Time)
    const now = new Date();
    const options = {
      timeZone: 'Asia/Manila',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    };

    const formatter = new Intl.DateTimeFormat('en-PH', options);
    document.getElementById('timestamp').innerText = `Today is ${formatter.format(now)}`;
  }

  // Update once immediately
  updateTimestamp();

  // Then update every second
  setInterval(updateTimestamp, 1000);
  </script>
