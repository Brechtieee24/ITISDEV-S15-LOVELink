<div class="profile-container">
  {{> navbar activePage="" }}

  <!-- Back Arrow -->
  <div class="back-arrow-wrapper">
    <a href="/view-other-members">
      <img src="/Images/arrow.png" alt="Back" class="back-arrow-img" />
    </a>
  </div>

  <!-- Combine avatar + name + activities into a single column -->
  <div class="full-column">
    <!-- Avatar -->
    <div class="user-avatar-wrapper">
      <img class="user-avatar" src="{{otherUserPhoto}}" alt="User" />
    </div>

    <!-- Name + Bio -->
    <div class="user-text-section">
      <div class="profile-name">
        {{firstName}} {{lastName}} <span class="italic">({{committee}})</span>
      </div>
      <div class="profile-bio">
        {{aboutInfo}}
      </div>
    </div>

    <!-- Activities Below -->
    <div class="activities-container">
      <div class="activities-label-wrapper">
        <div class="activities-label-text">List of Activities</div>
      </div>
      <div class="activities-section">
        <div class="activities-header">
          <div class="activities-title">Title</div>
          <div class="activities-date">Date</div>
        </div>
        <div class="activity-entries">
          {{#each activities}}
            <div class="activity-entry">
              <span>{{this.eventName}}</span>
              <span>{{this.date}}</span>
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>
</div>
