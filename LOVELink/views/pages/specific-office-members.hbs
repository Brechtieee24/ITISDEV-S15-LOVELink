<div class = "view-members-container">
    {{> navbar activePage="home"}}
    <div class = "content-container">
        <div class = "title">
            <h1>{{this.position}}</h1>
        </div>

        <div class = "members">
            {{!-- To add here is the when the button is clicked it will redirect it to the user's profile page --}}
            {{#each members}}
                <div class = "members-container"> 
                     <div class="member-details">
                        <img class="member-profile-picture" src="/images/user.png" alt="Avatar" />
                        <p>{{this.firstName}} {{this.lastName}}</p>
                    </div>

                    {{#if ../user.isOfficer}}
                        <p>{{this.formattedResidencyTime}}</p>
                    {{/if}}
                </div>
            {{/each}}
        </div>

        <div class = "buttons-container">
            <a href="/home" class="return-button">Return</a>
            
            {{!-- Filter to what? --}}
            {{#if user.isOfficer}}
            <button class="filter-button" onclick="document.getElementById('input-panel').style.display = 'block'">
                Filter Members
            </button>
            <div id="input-panel" class="add-filter-container" style="display:none;">
                <div class="top-part"> 
                    <span class="close-button" onclick="document.getElementById('input-panel').style.display='none'">x</span>
                </div>
                <div class="bottom-part">
                    <form action="/filtered-office-members" method="get">
                        <label for="hour">  Minimum Residency Hours:</label>
                        <input type="number" id="hour" name="hour" placeholder="e.g., 100" min="0">
                        <input type="hidden" name="position" value="{{position}}">

                        <button type="submit">Filter</button>
                    </form>
                </div>
            </div>
            {{/if}}
        </div>
    </div>
</div>

