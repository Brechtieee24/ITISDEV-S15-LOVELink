<div class = "view-members-container">
    {{> navbar activePage="home"}}
    <div class = "content-container">
        <div class = "title">
            <h1>{{this.position}}</h1>
        </div>

        <div class = "members">
            {{!-- To add here is the when the button is clicked it will redirect it to the user's profile page --}}
            {{#each members}}
                <div class = "members-container"> 
                    {{!-- No photo currently in the schema --}}
                     <div class="member-details">
                        <img class="member-profile-picture" src="/images/user.png" alt="Avatar" />
                        <p>{{this.firstName}} {{this.lastName}}</p>
                    </div>

                    {{!-- Not sure what time to get here --}}
                    {{#if ../user.isOfficer}}
                        <p>4:10:09</p>
                    {{/if}}
                </div>
            {{/each}}
        </div>

        <div class = "buttons-container">
            <a href="/home" class="return-button">Return</a>
            
            {{!-- Filter to what? --}}
            {{#if user.isOfficer}}
                <a href="/specific-office-members" class="filter-button">Filter Members</a>
            {{/if}}
        </div>
    </div>
</div>


