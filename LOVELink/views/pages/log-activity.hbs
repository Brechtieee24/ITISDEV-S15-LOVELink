<!-- residency.hbs -->
<div class="residency-page">
  {{> navbar activePage="residency" }}

  <div class="main-content-wrapper">
    <!-- Left Column (Avatar, Button, QR) -->
    <div class="left-column">
      <div class="user-avatar-wrapper">
        <img class="user-avatar" src="{{photo}}" alt="User" />
      </div>

      <!-- Log Residency Button (Link to logged-in page) -->
      <a href="/residency-logged-in" class="update-btn-wrapper">
        <div class="update-btn-text">Log Residency</div>
      </a>

      <!-- Log Activity Button -->
      <button class="update-btn-wrapper" onclick="document.getElementById('input-panel').style.display = 'block'">
        <div class="update-btn-text">Log Activity</div>
      </button>
     
     {{#if successMessage}}
        <div style="background-color: #d4edda; padding: 10px; border-radius: 5px; color: #155724; margin-bottom: 15px;">
           {{successMessage}}
        </div>
      {{/if}}

      <div id="input-panel" class="log-activity-container" style="display:none;">
        <div class="top-part"> 
          <button type="button" class="close-button" onclick="closePanel()">×</button>
        </div>
        <div class="bottom-part">
          <form action="/log-activity-input" method="post"> 
            <label for="eid">Event ID</label>
            <input type="text" id="eid" name="eid" required><br><br>

            <p>Scanned Participants: <span id="scanned-count">0</span></p>

            <div class="button-part"> 
              <button id="scanQrBtn" type="button">Scan QR</button>
              <button id="stopQrBtn" type="button" style="display:none;">Stop Scan</button>
              <div id="qr-video" style="width: 300px; margin-top: 10px;"></div>

              <input type="submit" value="Confirm">
            </div>
          </form>
        </div>
      </div>



    </div>

    <!-- Right Column (Name, Date, Table, Buttons) -->
    <div class="right-column">
      <!-- Name -->
      <div class="profile-name">
        {{firstName}} {{lastName}} <span class="italic">({{committee}})</span>
      </div>

      <!-- Timestamp -->
      <div class="current-timestamp" id="timestamp">
        Today is ...
      </div>

      <!-- Previous Residency Table -->
      <div class="residency-table-wrapper">
        <div class="table-header">Previous Residency</div>
        <div class="table-content">
          <div class="table-row">
            <strong>Time in:</strong> {{latestTimeIn}}
          </div>
          <div class="table-row">
            <strong>Time out:</strong> {{latestTimeOut}}
          </div>
          <div class="table-row">
            <strong>Total:</strong> {{duration}}
          </div>
        </div>
      </div>

  <script>
  function updateTimestamp() {
    // Create a new Date and convert to UTC+8 (Philippine Time)
    const now = new Date();
    const options = {
      timeZone: 'Asia/Manila',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    };

    const formatter = new Intl.DateTimeFormat('en-PH', options);
    document.getElementById('timestamp').innerText = `Today is ${formatter.format(now)}`;
  }

  // Update once immediately
  updateTimestamp();

  // Then update every second
  setInterval(updateTimestamp, 1000);

  </script>

<!-- QR Related Scripts -->
<script src="https://unpkg.com/html5-qrcode"></script>
<script>
  let html5QrCode;
  let scannedCount = 0;
  const scannedSet = new Set();

  async function startQRScanner() {
    const videoEl = document.getElementById('qr-video');
    html5QrCode = new Html5Qrcode("qr-video");

    const devices = await Html5Qrcode.getCameras();
    const cameraId = devices[0]?.id;

    if (!cameraId) {
      alert("No camera found.");
      return;
    }

    document.getElementById('scanQrBtn').disabled = true;
    document.getElementById('stopQrBtn').style.display = 'inline-block';

    html5QrCode.start(
      cameraId,
      { fps: 10, qrbox: 250 },
      async (decodedText, decodedResult) => {
        if (!scannedSet.has(decodedText)) {
          scannedSet.add(decodedText);
          scannedCount++;
          document.getElementById('scanned-count').textContent = scannedCount;

          // Visual feedback
          const flash = document.createElement('div');
          flash.textContent = "✔ Scan successful!";
          flash.style.color = "green";
          flash.style.marginTop = "5px";
          videoEl.after(flash);
          setTimeout(() => flash.remove(), 1500);

          // Save to session
          await fetch('/store-qr', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ data: decodedText })
          });
        }
      },
      err => {
        console.warn("QR scan error", err);
      }
    );
  }

  async function stopQRScanner() {
    if (html5QrCode) {
      await html5QrCode.stop();
      html5QrCode.clear();
    }
    document.getElementById('stopQrBtn').style.display = 'none';
    document.getElementById('scanQrBtn').disabled = false;
  }

  document.getElementById('scanQrBtn').addEventListener('click', startQRScanner);
  document.getElementById('stopQrBtn').addEventListener('click', stopQRScanner);

  function closePanel() {
    document.getElementById('input-panel').style.display = 'none';
    stopQRScanner();
    resetScannerState();
  }

  function openPanel() {
    resetScannerState();
    document.getElementById('input-panel').style.display = 'block';
  }

  function resetScannerState() {
    scannedCount = 0;
    scannedSet.clear();
    document.getElementById('scanned-count').textContent = scannedCount;
    document.getElementById('scanQrBtn').disabled = false;
    document.getElementById('stopQrBtn').style.display = 'none';
  }
</script>




